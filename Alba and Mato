// Display function
    void display() {
        cout << "Elements: ";

        for (int i = 0; i < size; i++) {
            cout << arr[i] << " ";
        }

        cout << "\nSize: " << size;
        cout << "\nCapacity: " << capacity << endl;
        cout << "----------------------" << endl;
    }

    // Destructor
    ~DynamicArray() {
        delete[] arr;
    }

    // Display total resizing operations
    void showResizeCount() {
        cout << "\nTotal resizing operations: "
             << resizeCount << endl;
    }
